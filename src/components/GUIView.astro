---
import { PORTFOLIO_DATA } from '../data/portfolio';
import Neofetch from './Neofetch.astro';

const { developer, skills, collabs } = PORTFOLIO_DATA;
---

<div id="view-gui" class="hidden flex flex-col space-y-6 font-mono text-xs md:text-sm">
  <!-- Top Neofetch System Summary Card -->
  <Neofetch />

  <!-- Main TUI Grid: Sidebar Directory Navigation + Main Panel -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Sidebar Navigation Tree -->
    <aside class="lg:col-span-3 border border-[var(--border-color)] bg-[var(--bg-card)] p-4 space-y-4">
      <div class="text-[var(--accent)] font-bold border-b border-[var(--border-color)] pb-2 flex items-center justify-between">
        <span>📁 EXPLORER</span>
        <span class="text-[10px] text-[var(--fg-dim)]">CONTENTS</span>
      </div>

      <nav class="space-y-1 font-mono text-xs">
        <a href="#gui-about" class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] font-bold transition-colors">
          <span class="text-yellow-400">📄</span> bio.txt (About Me)
        </a>
        <a href="#gui-skills" class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] transition-colors">
          <span class="text-emerald-400">⚙️</span> skills.sh (Skills)
        </a>
        <a href="#gui-collabs" class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] transition-colors">
          <span class="text-purple-400">🤝</span> collabs.md (Collabs)
        </a>
        <a href="#gui-contact" class="gui-nav-item flex items-center gap-2 p-1.5 hover:bg-[var(--border-color)] text-[var(--fg-bright)] transition-colors">
          <span class="text-red-400">✉️</span> contact.txt (Contact)
        </a>
      </nav>

      <!-- Quick Metrics -->
      <div class="pt-4 border-t border-[var(--border-color)] space-y-2 text-[11px]">
        <div class="text-[var(--fg-dim)] font-bold uppercase tracking-wider text-[10px]">CONTENT SPEC</div>
        <div class="flex justify-between text-[var(--fg-main)]">
          <span>Active Collabs:</span>
          <span class="font-bold text-[var(--fg-bright)]">{collabs.length}</span>
        </div>
        <div class="flex justify-between text-[var(--fg-main)]">
          <span>Skill Domains:</span>
          <span class="font-bold text-yellow-400">{skills.length}</span>
        </div>
        <div class="flex justify-between text-[var(--fg-main)]">
          <span>Experience:</span>
          <span class="font-bold text-emerald-400">7+ Years</span>
        </div>
      </div>

      <!-- Quick GitHub Link -->
      <div class="pt-2">
        <a href={developer.github} target="_blank" rel="noopener noreferrer" class="w-full text-center block px-3 py-1.5 border border-[var(--border-color)] bg-[var(--bg-main)] hover:border-[var(--border-active)] text-[var(--fg-bright)] text-xs font-bold transition-colors">
          GitHub Profile ↗
        </a>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="lg:col-span-9 space-y-8">
      
      <!-- Section 1: About Me -->
      <section id="gui-about" class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-3">
          <h2 class="text-base font-bold text-[var(--fg-bright)] flex items-center gap-2">
            <span class="text-[var(--accent)]">></span> CAT BIO.TXT // ABOUT ME
          </h2>
          <span class="text-xs text-[var(--fg-dim)]">[READ-ONLY]</span>
        </div>

        <p class="text-[var(--fg-main)] leading-relaxed text-sm">
          {developer.bio}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          <div class="p-3 border border-[var(--border-color)] bg-[var(--bg-main)] space-y-1">
            <span class="text-[10px] text-[var(--fg-dim)] uppercase font-bold">ENGINEERING FOCUS</span>
            <div class="text-xs text-[var(--accent)] font-bold">Systems Architecture, Edge Systems & Web Performance</div>
          </div>
          <div class="p-3 border border-[var(--border-color)] bg-[var(--bg-main)] space-y-1">
            <span class="text-[10px] text-[var(--fg-dim)] uppercase font-bold">LOCATION</span>
            <div class="text-xs text-[var(--fg-bright)] font-bold">📍 {developer.location}</div>
          </div>
        </div>
      </section>

      <!-- Section 2: Skills -->
      <section id="gui-skills" class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-3">
          <h2 class="text-base font-bold text-[var(--fg-bright)] flex items-center gap-2">
            <span class="text-[var(--accent)]">></span> ./SKILLS.SH // TECHNICAL PROFICIENCY
          </h2>
          <span class="text-xs text-[var(--fg-dim)]">[PROFICIENCY METRICS]</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {skills.map((cat) => (
            <div class="border border-[var(--border-color)] bg-[var(--bg-main)] p-4 space-y-3">
              <div class="text-xs font-bold text-[var(--accent)] flex items-center gap-2 border-b border-[var(--border-color)] pb-2">
                <span>{cat.icon}</span>
                <span>{cat.category}</span>
              </div>

              <div class="space-y-2.5">
                {cat.skills.map((skill) => {
                  const filledCount = Math.round(skill.level / 10);
                  const barStr = '█'.repeat(filledCount) + '░'.repeat(10 - filledCount);
                  return (
                    <div class="space-y-1">
                      <div class="flex justify-between text-xs font-bold">
                        <span class="text-[var(--fg-bright)]">{skill.name}</span>
                        <span class="text-[var(--fg-dim)] text-[10px]">{skill.experience}</span>
                      </div>
                      <div class="flex items-center gap-2 text-xs">
                        <div class="flex-1 bg-[var(--bg-card)] border border-[var(--border-color)] h-4 overflow-hidden relative flex items-center px-1">
                          <div class="h-full bg-[var(--fg-dim)] opacity-40 absolute left-0 top-0" style={`width: ${skill.level}%`}></div>
                          <span class="relative z-10 text-[10px] text-[var(--fg-bright)] font-mono">{barStr} {skill.level}%</span>
                        </div>
                        <span class="text-[9px] px-1 bg-[var(--border-color)] text-[var(--accent)] font-bold">{skill.tag}</span>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 3: Collabs (Collaborations) -->
      <section id="gui-collabs" class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-3">
          <h2 class="text-base font-bold text-[var(--fg-bright)] flex items-center gap-2">
            <span class="text-[var(--accent)]">></span> CAT COLLABS.MD // TEAM COLLABORATIONS
          </h2>
          <span class="text-xs text-[var(--fg-dim)]">[PARTNERSHIPS]</span>
        </div>

        <div class="space-y-4">
          {collabs.map((item) => (
            <div class="border border-[var(--border-color)] bg-[var(--bg-main)] p-5 space-y-3 hover:border-[var(--border-active)] transition-all">
              <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-color)] pb-2">
                <h3 class="text-sm font-bold text-[var(--fg-bright)] flex items-center gap-2">
                  <span>🤝</span> {item.title}
                </h3>
                <span class="text-[10px] px-2 py-0.5 border border-[var(--border-color)] text-[var(--accent)] uppercase font-bold">
                  {item.partnerType}
                </span>
              </div>

              {item.asciiLogo && (
                <pre class="my-2 p-2 bg-[var(--bg-card)] text-[10px] text-[var(--fg-dim)] overflow-x-auto leading-tight select-none border border-[var(--border-color)]">{item.asciiLogo}</pre>
              )}

              <div class="text-xs">
                <span class="text-[var(--accent)] font-bold">Partner Org:</span> <span class="text-[var(--fg-bright)] font-bold">{item.partner}</span>
                <span class="mx-2 text-[var(--fg-dim)]">|</span>
                <span class="text-[var(--accent)] font-bold">Role:</span> <span class="text-emerald-400 font-bold">{item.role}</span>
                <span class="mx-2 text-[var(--fg-dim)]">|</span>
                <span class="text-[var(--fg-dim)]">{item.period}</span>
              </div>

              <p class="text-xs text-[var(--fg-main)] leading-relaxed">
                {item.description}
              </p>

              <div class="space-y-1 pt-1">
                <span class="text-[10px] text-[var(--fg-dim)] uppercase font-bold">Key Contributions:</span>
                <ul class="list-disc list-inside text-xs text-[var(--fg-main)] space-y-0.5">
                  {item.contributions.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              </div>

              <div class="flex flex-wrap items-center justify-between pt-3 border-t border-[var(--border-color)] gap-2">
                <div class="flex flex-wrap gap-1">
                  {item.techStack.map((t) => (
                    <span class="text-[10px] px-1.5 py-0.5 bg-[var(--bg-card)] text-[var(--fg-dim)] border border-[var(--border-color)]">
                      {t}
                    </span>
                  ))}
                </div>

                {item.link && (
                  <a href={item.link} target="_blank" rel="noopener noreferrer" class="text-xs text-[var(--accent)] hover:underline font-bold">
                    View Project ↗
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 4: Contact -->
      <section id="gui-contact" class="border border-[var(--border-color)] bg-[var(--bg-card)] p-5 space-y-4">
        <div class="flex items-center justify-between border-b border-[var(--border-color)] pb-3">
          <h2 class="text-base font-bold text-[var(--fg-bright)] flex items-center gap-2">
            <span class="text-[var(--accent)]">></span> TRANSMIT MAIL // CONTACT
          </h2>
          <span class="text-xs text-[var(--fg-dim)]">[INQUIRIES]</span>
        </div>

        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label for="contact-name" class="text-xs text-[var(--fg-bright)] font-bold block">NAME:</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                required
                placeholder="e.g. Linus Torvalds"
                class="w-full bg-[var(--bg-main)] text-[var(--fg-bright)] border border-[var(--border-color)] focus:border-[var(--border-active)] p-2 text-xs font-mono focus:outline-none"
              />
            </div>
            <div class="space-y-1">
              <label for="contact-email" class="text-xs text-[var(--fg-bright)] font-bold block">EMAIL:</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                placeholder="linus@kernel.org"
                class="w-full bg-[var(--bg-main)] text-[var(--fg-bright)] border border-[var(--border-color)] focus:border-[var(--border-active)] p-2 text-xs font-mono focus:outline-none"
              />
            </div>
          </div>

          <div class="space-y-1">
            <label for="contact-message" class="text-xs text-[var(--fg-bright)] font-bold block">MESSAGE / COLLAB PROPOSAL:</label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="4"
              placeholder="Enter your message or collaboration inquiry..."
              class="w-full bg-[var(--bg-main)] text-[var(--fg-bright)] border border-[var(--border-color)] focus:border-[var(--border-active)] p-2 text-xs font-mono focus:outline-none resize-none"
            ></textarea>
          </div>

          <div class="flex items-center justify-between pt-2">
            <span id="form-status" class="text-xs font-bold text-emerald-400 hidden">
              ✓ Message payload successfully transmitted!
            </span>
            <button
              type="submit"
              class="px-5 py-2 border border-[var(--border-active)] bg-[var(--border-color)] hover:bg-[var(--border-active)] text-[var(--fg-bright)] font-bold text-xs cursor-pointer transition-colors ml-auto"
            >
              SEND PAYLOAD [ENTER]
            </button>
          </div>
        </form>
      </section>

    </div>
  </div>
</div>

<script>
  import confetti from 'canvas-confetti';
  import { playSuccessSound } from '../utils/sound';

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const statusMsg = document.getElementById('form-status');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      playSuccessSound();

      confetti({
        particleCount: 80,
        spread: 60,
        origin: { y: 0.7 },
        colors: ['#00ff66', '#00f0ff', '#ffb000', '#bd93f9']
      });

      if (statusMsg) {
        statusMsg.classList.remove('hidden');
        setTimeout(() => statusMsg.classList.add('hidden'), 5000);
      }
      form.reset();
    });
  });
</script>
