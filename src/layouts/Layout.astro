---
import "../styles/global.css";
import MatrixRain from "../components/MatrixRain.astro";
import { getPortfolio } from "../data/i18n";
import { LANG_PATH, toLang } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const lang = toLang(Astro.props.lang);
const PORTFOLIO_DATA = getPortfolio(lang);

const {
  title = `${PORTFOLIO_DATA.developer.name} // TUI Portfolio`,
  description = PORTFOLIO_DATA.developer.bio,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} data-theme="green">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0a120b" />
    <link rel="alternate" hreflang="en" href={LANG_PATH.en} />
    <link rel="alternate" hreflang="es" href={LANG_PATH.es} />

    <script is:inline>
      if (location.pathname === "/" && localStorage.getItem("tui_lang") === "es") {
        location.replace("/es/" + location.hash);
      }
    </script>
    <script>
      import { applyTheme } from "../config/themeConfig";
      const savedTheme = localStorage.getItem("tui_theme") || "green";
      applyTheme(savedTheme);
    </script>
  </head>
  <body
    class="min-h-screen relative flex flex-col justify-between py-4 sm:py-8 px-2 sm:px-4 crt-flicker"
  >
    <div id="crt-overlay-layer" class="crt-overlay"></div>
    <div class="crt-vignette"></div>

    <MatrixRain />

    <div class="w-full my-auto z-10">
      <slot />
    </div>
  </body>
</html>
